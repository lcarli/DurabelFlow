{
  "Durable Orchestrator Function": {
    "prefix": "df-orch",
    "description": "Durable Functions orchestrator (TypeScript)",
    "body": [
      "import * as df from 'durable-functions';",
      "",
      "const ${1:orchestratorName}: df.OrchestrationHandler = function* (context) {",
      "  const outputs = [];",
      "",
      "  outputs.push(yield context.df.callActivity('${2:ActivityName}', '${3:input}'));",
      "",
      "  return outputs;",
      "};",
      "",
      "df.app.orchestration('${1:orchestratorName}', ${1:orchestratorName});"
    ]
  },
  "Durable Activity Function": {
    "prefix": "df-activity",
    "description": "Durable Functions activity (TypeScript)",
    "body": [
      "import { app, InvocationContext } from '@azure/functions';",
      "import * as df from 'durable-functions';",
      "",
      "function ${1:activityName}(input: ${2:string}, context: InvocationContext): ${3:string} {",
      "  context.log('${1:activityName} processing:', input);",
      "  return `${4:Hello} \\${input}`;",
      "}",
      "",
      "df.app.activity('${1:activityName}', { handler: ${1:activityName} });"
    ]
  },
  "Durable Client / HTTP Starter": {
    "prefix": "df-client",
    "description": "Durable Functions HTTP starter client (TypeScript)",
    "body": [
      "import { app, HttpRequest, HttpResponseInit, InvocationContext } from '@azure/functions';",
      "import * as df from 'durable-functions';",
      "",
      "async function ${1:httpStart}(req: HttpRequest, context: InvocationContext): Promise<HttpResponseInit> {",
      "  const client = df.getClient(context);",
      "  const body = await req.text();",
      "  const instanceId = await client.startNew('${2:OrchestratorName}', { input: body });",
      "",
      "  context.log(`Started orchestration with ID = '\\${instanceId}'.`);",
      "",
      "  return client.createCheckStatusResponse(req, instanceId);",
      "}",
      "",
      "app.http('${1:httpStart}', {",
      "  route: 'orchestrators/${2:OrchestratorName}',",
      "  extraInputs: [df.input.durableClient()],",
      "  handler: ${1:httpStart},",
      "});"
    ]
  },
  "Durable Entity Function": {
    "prefix": "df-entity",
    "description": "Durable Functions entity (TypeScript)",
    "body": [
      "import * as df from 'durable-functions';",
      "",
      "const ${1:entityName}: df.EntityHandler<${2:number}> = function (context) {",
      "  const currentValue = context.df.getState(() => 0) as ${2:number};",
      "",
      "  switch (context.df.operationName) {",
      "    case 'add':",
      "      context.df.setState(currentValue + (context.df.input as ${2:number}));",
      "      break;",
      "    case 'reset':",
      "      context.df.setState(0);",
      "      break;",
      "    case 'get':",
      "      context.df.return(currentValue);",
      "      break;",
      "  }",
      "};",
      "",
      "df.app.entity('${1:entityName}', ${1:entityName});"
    ]
  },
  "Durable Function Chaining Pattern": {
    "prefix": "df-chain",
    "description": "Function chaining pattern (TypeScript)",
    "body": [
      "import * as df from 'durable-functions';",
      "",
      "const ${1:chainOrchestrator}: df.OrchestrationHandler = function* (context) {",
      "  const result1 = yield context.df.callActivity('${2:Step1}', context.df.input);",
      "  const result2 = yield context.df.callActivity('${3:Step2}', result1);",
      "  const result3 = yield context.df.callActivity('${4:Step3}', result2);",
      "",
      "  return result3;",
      "};",
      "",
      "df.app.orchestration('${1:chainOrchestrator}', ${1:chainOrchestrator});"
    ]
  },
  "Durable Fan-Out/Fan-In Pattern": {
    "prefix": "df-fanout",
    "description": "Fan-out/fan-in pattern (TypeScript)",
    "body": [
      "import * as df from 'durable-functions';",
      "",
      "const ${1:fanOutFanInOrchestrator}: df.OrchestrationHandler = function* (context) {",
      "  const workItems: ${2:string}[] = yield context.df.callActivity('${3:GetWorkItems}');",
      "",
      "  // Fan out: schedule all tasks in parallel",
      "  const parallelTasks = workItems.map((item) =>",
      "    context.df.callActivity('${4:ProcessItem}', item),",
      "  );",
      "",
      "  // Fan in: wait for all tasks to complete",
      "  const results = yield context.df.Task.all(parallelTasks);",
      "",
      "  // Aggregate results",
      "  const summary = yield context.df.callActivity('${5:Summarize}', results);",
      "  return summary;",
      "};",
      "",
      "df.app.orchestration('${1:fanOutFanInOrchestrator}', ${1:fanOutFanInOrchestrator});"
    ]
  },
  "Durable Sub-Orchestration Pattern": {
    "prefix": "df-sub-orch",
    "description": "Sub-orchestration pattern (TypeScript)",
    "body": [
      "import * as df from 'durable-functions';",
      "",
      "const ${1:parentOrchestrator}: df.OrchestrationHandler = function* (context) {",
      "  // Call sub-orchestration",
      "  const result = yield context.df.callSubOrchestrator(",
      "    '${2:ChildOrchestrator}',",
      "    context.df.input,",
      "  );",
      "",
      "  return result;",
      "};",
      "",
      "df.app.orchestration('${1:parentOrchestrator}', ${1:parentOrchestrator});"
    ]
  },
  "Durable Human Interaction Pattern": {
    "prefix": "df-human",
    "description": "Human interaction / approval pattern with timeout (TypeScript)",
    "body": [
      "import * as df from 'durable-functions';",
      "",
      "const ${1:approvalOrchestrator}: df.OrchestrationHandler = function* (context) {",
      "  yield context.df.callActivity('${2:RequestApproval}', context.df.input);",
      "",
      "  // Wait for approval event or timeout",
      "  const expiration = new Date(context.df.currentUtcDateTime);",
      "  expiration.setHours(expiration.getHours() + ${3:72});",
      "",
      "  const timeoutTask = context.df.createTimer(expiration);",
      "  const approvalTask = context.df.waitForExternalEvent('${4:ApprovalEvent}');",
      "",
      "  const winner = yield context.df.Task.any([approvalTask, timeoutTask]);",
      "",
      "  if (winner === approvalTask) {",
      "    timeoutTask.cancel();",
      "    yield context.df.callActivity('${5:ProcessApproval}', approvalTask.result);",
      "  } else {",
      "    yield context.df.callActivity('${6:HandleTimeout}', 'Approval timed out');",
      "  }",
      "};",
      "",
      "df.app.orchestration('${1:approvalOrchestrator}', ${1:approvalOrchestrator});"
    ]
  },
  "Durable Monitor Pattern": {
    "prefix": "df-monitor",
    "description": "Monitor / polling pattern (TypeScript)",
    "body": [
      "import * as df from 'durable-functions';",
      "",
      "const ${1:monitorOrchestrator}: df.OrchestrationHandler = function* (context) {",
      "  const endTime = new Date(context.df.currentUtcDateTime);",
      "  endTime.setHours(endTime.getHours() + ${2:6});",
      "",
      "  while (context.df.currentUtcDateTime < endTime) {",
      "    const status = yield context.df.callActivity('${3:CheckStatus}', context.df.input);",
      "",
      "    if (status === '${4:done}') {",
      "      yield context.df.callActivity('${5:SendNotification}', 'Job completed!');",
      "      return 'completed';",
      "    }",
      "",
      "    // Wait before next check",
      "    const nextCheck = new Date(context.df.currentUtcDateTime);",
      "    nextCheck.setSeconds(nextCheck.getSeconds() + ${6:30});",
      "    yield context.df.createTimer(nextCheck);",
      "  }",
      "",
      "  return 'timed out';",
      "};",
      "",
      "df.app.orchestration('${1:monitorOrchestrator}', ${1:monitorOrchestrator});"
    ]
  },
  "Durable Eternal Orchestration Pattern": {
    "prefix": "df-eternal",
    "description": "Eternal orchestration pattern (TypeScript)",
    "body": [
      "import * as df from 'durable-functions';",
      "",
      "const ${1:eternalOrchestrator}: df.OrchestrationHandler = function* (context) {",
      "  yield context.df.callActivity('${2:DoWork}', context.df.input);",
      "",
      "  // Wait before next iteration",
      "  const nextRun = new Date(context.df.currentUtcDateTime);",
      "  nextRun.setMinutes(nextRun.getMinutes() + ${3:5});",
      "  yield context.df.createTimer(nextRun);",
      "",
      "  // Continue as new to avoid unbounded history",
      "  context.df.continueAsNew(context.df.input);",
      "};",
      "",
      "df.app.orchestration('${1:eternalOrchestrator}', ${1:eternalOrchestrator});"
    ]
  }
}
